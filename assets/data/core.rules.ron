// Core game data. Distances are in tiles; speeds are in tiles per second.
// Each tile holds up to tile_capacity total unit size, regardless of player.
(
    tile_capacity: 4,
    terrain: [
        (id: "grass", symbol: '.', walkable: true, color: "#4a7a3e", texture: Some("textures/terrain/grass.png")),
        (id: "dirt", symbol: ',', walkable: true, color: "#8a7350", texture: Some("textures/terrain/dirt.png")),
        (id: "sand", symbol: ':', walkable: true, color: "#c9b27a", texture: Some("textures/terrain/sand.png")),
        (id: "water", symbol: '~', walkable: false, color: "#2e5d8c", texture: Some("textures/terrain/water.png")),
        (id: "rock", symbol: '#', walkable: false, color: "#5a5852", texture: Some("textures/terrain/rock.png")),
    ],
    units: [
        (id: "worker", size: 1, max_health: 40, radius: 0.3, speed: 2.5),
        (id: "soldier", size: 2, max_health: 80, radius: 0.4, speed: 3.0),
    ],
)
