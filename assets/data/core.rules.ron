// Core game data. Distances are in tiles; speeds are in tiles per second.
// Each tile holds up to tile_capacity total unit size, regardless of player.
// A unit is a squad of `squad` soldiers (default 1); max_health is per soldier.
// Each living soldier fires its weapon once per cooldown (seconds) at targets within range.
(
    tile_capacity: 4,
    terrain: [
        (id: "grass", symbol: '.', speed_modifier: 1.0, color: "#4a7a3e", texture: Some("textures/terrain/grass.png")),
        (id: "dirt", symbol: ',', speed_modifier: 1.1, color: "#8a7350", texture: Some("textures/terrain/dirt.png")),
        (id: "sand", symbol: ':', speed_modifier: 0.9, color: "#c9b27a", texture: Some("textures/terrain/sand.png")),
        (id: "water", symbol: '~', speed_modifier: 0.0, color: "#2e5d8c", texture: Some("textures/terrain/water.png")),
        (id: "rock", symbol: '#', speed_modifier: 0.0, color: "#5a5852", texture: Some("textures/terrain/rock.png")),
    ],
    units: [
        (id: "worker", sprite: "textures/units/worker.png", size: 1, max_health: 40, radius: 0.3, speed: 3.0),
        (id: "soldier", sprite: "textures/units/soldier.png", size: 2, squad: 6, max_health: 30, radius: 0.45, speed: 2.5,
         weapon: Some((range: 3.0, damage: 4, cooldown: 1.0))),
    ],
    // Veterancy. Kills count enemy soldiers; each new rank restores the whole squad,
    // including fallen soldiers, and raises damage per shot by damage_bonus percent.
    ranks: [
        (name: "Veteran", kills: 6, damage_bonus: 25),
        (name: "Elite", kills: 18, damage_bonus: 50),
        (name: "Hero", kills: 36, damage_bonus: 100),
    ],
)
