// Local presentation settings. Colors are sRGB (red, green, blue), each from 0 to 1.
// These settings stay on the client; they are not part of match setup or replays.
(
    // Colors by player slot. A shorter palette repeats for subsequent slots.
    player_colors: [
        (0.20, 0.45, 0.90),
        (0.85, 0.20, 0.20),
        (0.95, 0.80, 0.20),
        (0.30, 0.75, 0.35),
        (0.65, 0.35, 0.85),
        (0.95, 0.55, 0.15),
        (0.25, 0.80, 0.85),
        (0.90, 0.90, 0.90),
    ],
    selection: (
        color: (0.95, 0.83, 0.45),
        padding: 4.0, // Screen pixels outside the unit footprint.
        accepted_order_color: (0.60, 0.90, 0.65),
        blocked_order_color: (1.0, 0.35, 0.25),
        marker_radius: 12.0, // Screen pixels.
        marker_cross_size: 5.0, // Screen pixels.
        marker_duration: 0.6, // Seconds.
    ),
    terrain_detail: (
        colors_below: 40.0, // Switch textures to colors below this many screen pixels per tile.
        textures_at: 48.0, // Switch colors to textures at this threshold; must exceed colors_below.
    ),
)
